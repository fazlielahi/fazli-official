{
    "name": "Classic",
    "slug": "classic",
    "description": "A classic CV template with a professional layout",
    "sections": {
        "required": ["header", "summary"],
        "optional": ["experience", "education", "skills", "projects", "certifications", "languages", "awards"]
    },
    "layout": {
        "type": "single-column",
        "regions": {
            "header": {
                "position": "top",
                "fields": ["name", "email", "phone", "address", "linkedin", "github"]
            },
            "body": {
                "position": "main",
                "sections": ["summary", "experience", "education", "skills", "projects"]
            }
        }
    },
    "styling": {
        "primary_color": "#2133af",
        "secondary_color": "#4a43af",
        "font_family": "Arial, sans-serif",
        "font_size": "14px"
    },
    "fields": {
        "header": {
            "name": {"type": "text", "required": true, "label": "Full_Name"},
            "email": {"type": "email", "required": true, "label": "Email"},
            "phone": {"type": "tel", "required": false, "label": "Phone"},
            "address": {"type": "text", "required": false, "label": "Address"},
            "linkedin": {"type": "url", "required": false, "label": "LinkedIn"},
            "github": {"type": "url", "required": false, "label": "GitHub"}
        },
        "summary": {
            "summary": {"type": "textarea", "required": false, "label": "Professional Summary"}
        },
        "experience": {
            "title": {"type": "text", "required": true, "label": "Job Title"},
            "company": {"type": "text", "required": true, "label": "Company"},
            "period": {"type": "text", "required": false, "label": "Period"},
            "description": {"type": "textarea", "required": false, "label": "Description"}
        },
        "education": {
            "degree": {"type": "text", "required": true, "label": "Degree"},
            "institution": {"type": "text", "required": true, "label": "Institution"},
            "period": {"type": "text", "required": false, "label": "Period"}
        }
    }
}


